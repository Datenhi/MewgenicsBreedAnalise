# ============================================================================
# .gitignore — Mewgenics Pedigree Analyzer
# ВАЖНО: файлы сохранений (.sav) содержат личные игровые данные —
# они не должны попадать в репозиторий и на деплой.
# ============================================================================

# ---------------------------------------------------------------------------
# ПРИВАТНОСТЬ — никогда не коммитить
# ---------------------------------------------------------------------------

# Личные файлы сохранений и загруженные пользователем файлы
/upload/
/public/demo/
**/*.sav
*.sav

# Скриншоты и артефакты анализа (содержат личные игровые данные)
/scripts/
/screenshots/
/.zscripts/

# Внутренний журнал разработки
worklog.md

# Папка для скачиваемых результатов
/download/

# Локальные базы данных (шаблонные, приложением не используются)
/db/

# ---------------------------------------------------------------------------
# Зависимости
# ---------------------------------------------------------------------------

node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Сборка Next.js
# ---------------------------------------------------------------------------

/.next/
/.next-static/
/out/
/build/
/coverage/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Логи и отладка
# ---------------------------------------------------------------------------

*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Окружение и секреты
# ---------------------------------------------------------------------------

.env
.env.*
!.env.example
*.pem
.vercel

# ---------------------------------------------------------------------------
# Служебные папки и файлы песочницы (не относятся к проекту)
# ---------------------------------------------------------------------------

/skills/
/mini-services/
/examples/
/tests/
.claude/
local-*
test
prompt
*.sh

# ---------------------------------------------------------------------------
# ОС и редакторы
# ---------------------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
package-lock.json
